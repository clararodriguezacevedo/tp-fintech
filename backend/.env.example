SUPABASE_URL=https://your-project.supabase.co
# Service role key: the backend writes to every table. Never expose it to the frontend.
SUPABASE_KEY=
# Only for running migrations: Connect > Session pooler URI, with your DB password.
DATABASE_URL=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
TAGGER_MODEL=gemini-3.5-flash-lite

IOL_USERNAME=
IOL_PASSWORD=
# false = paper trading (simulated with real IOL prices). true sends real orders.
IOL_LIVE_TRADING=false

# Jobs run on GitHub Actions. true = also run them inside the API (offline development).
RUN_SCHEDULER=false
COLLECT_INTERVAL_MINUTES=10

# Required once deployed: clients send it as X-API-Key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated, e.g. http://localhost:3000,https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
RISK_PER_TRADE=0.01
